buffers {
  size_kb: 262144
  fill_policy: RING_BUFFER
}

data_sources {
  config {
    name: "linux.ftrace"
    ftrace_config {
      # 频率与上限：判断"我们设的天花板有没有生效"的最小组合
      ftrace_events: "power/cpu_frequency"
      ftrace_events: "power/cpu_frequency_limits"
      # FPSGO 决策（jerk/limit 分支），不采 fbt_systrace（单局 750 万条，体量最大）
      ftrace_events: "fpsgo/fpsgo_main_systrace"
      ftrace_events: "fpsgo/fstb_systrace"
      buffer_size_kb: 65536
      buffer_size_lower_bound: true
      drain_period_ms: 100
      symbolize_ksyms: false
    }
  }
}

data_sources {
  config {
    name: "linux.sys_stats"
    sys_stats_config {
      cpufreq_period_ms: 100
    }
  }
}

data_sources {
  config {
    name: "linux.sys_stats"
    sys_stats_config {
      stat_period_ms: 100
      stat_counters: STAT_CPU_TIMES
      cpuidle_period_ms: 100
    }
  }
}

data_sources {
  config {
    name: "android.power"
    android_power_config {
      battery_poll_ms: 100
      battery_counters: BATTERY_COUNTER_CURRENT
      battery_counters: BATTERY_COUNTER_VOLTAGE
      battery_counters: BATTERY_COUNTER_CHARGE
      collect_power_rails: false
    }
  }
}

data_sources {
  config {
    name: "android.surfaceflinger.frametimeline"
  }
}

data_sources {
  config {
    name: "android.log"
    android_log_config {
      log_ids: LID_DEFAULT
      min_prio: PRIO_INFO
      filter_tags: "sgame_unity"
      filter_tags: "grid"
    }
  }
}

duration_ms: 600000
write_into_file: true
max_file_size_bytes: 2000000000
