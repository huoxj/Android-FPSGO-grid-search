# 探针配置（无 kprobe）：查"谁在写频率上限" + 温控余量
#
# 关键事件：
#   perf_tracker/freq_qos_user_setting —— 频率 QoS 写入者（caller 字符串 + cid/type/value）
#                                        这是查 2.4GHz 盖子的主武器，比 kprobe 更直接
#   power/cpu_frequency_limits           —— 聚合后的上限变化
#
# 体量：300s 约 1–1.5GB，输出必须放 /mnt/z1
buffers {
  size_kb: 524288
  fill_policy: RING_BUFFER
}

data_sources {
  config {
    name: "linux.ftrace"
    ftrace_config {
      # ── FPSGO 决策 ──
      ftrace_events: "fpsgo/fpsgo_main_systrace"
      ftrace_events: "fpsgo/fbt_systrace"
      ftrace_events: "fpsgo/fstb_systrace"
      ftrace_events: "fpsgo/fpsgo_main_trace"
      ftrace_events: "fpsgo/xgf_systrace"
      # ── 调度 ──
      ftrace_events: "sched/sched_switch"
      ftrace_events: "sched/sched_waking"
      # ── 频率 / 上限 / 空闲 ──
      ftrace_events: "power/cpu_frequency"
      ftrace_events: "power/cpu_frequency_limits"
      ftrace_events: "power/cpu_idle"
      # ── 频率 QoS 写入者（本次重点）──
      ftrace_events: "perf_tracker/freq_qos_user_setting"
      # ── MTK 温控余量 ──
      buffer_size_kb: 65536
      buffer_size_lower_bound: true
      drain_period_ms: 100
      symbolize_ksyms: false
    }
  }
}

data_sources {
  config {
    name: "linux.sys_stats"
    sys_stats_config {
      cpufreq_period_ms: 1000
      stat_period_ms: 500
      stat_counters: STAT_CPU_TIMES
    }
  }
}

data_sources {
  config {
    name: "android.power"
    android_power_config {
      battery_poll_ms: 200
      battery_counters: BATTERY_COUNTER_CURRENT
      battery_counters: BATTERY_COUNTER_VOLTAGE
    }
  }
}

data_sources {
  config {
    name: "android.surfaceflinger.frametimeline"
  }
}

data_sources {
  config {
    name: "android.log"
    android_log_config {
      log_ids: LID_DEFAULT
      min_prio: PRIO_INFO
      filter_tags: "sgame_unity"
      filter_tags: "grid"
    }
  }
}

duration_ms: 420000
write_into_file: true
max_file_size_bytes: 8000000000
