buffers {
  size_kb: 65526
  fill_policy: RING_BUFFER
}

data_sources {
  config {
    name: "linux.sys_stats"
    sys_stats_config {
      cpufreq_period_ms: 100
    }
  }
}

data_sources {
  config {
    name: "linux.sys_stats"
    sys_stats_config {
      stat_period_ms: 100
      stat_counters: STAT_CPU_TIMES
      cpuidle_period_ms: 100
    }
  }
}

data_sources {
  config {
    name: "android.power"
    android_power_config {
      battery_poll_ms: 250
      battery_counters: BATTERY_COUNTER_CURRENT
      collect_power_rails: false
    }
  }
}

data_sources {
  config {
    name: "android.surfaceflinger.frametimeline"
  }
}

duration_ms: 600000
write_into_file: true
max_file_size_bytes: 500000000
